if(NOT DEFINED BUILD_DIR OR NOT DEFINED APP_DIR OR NOT DEFINED BIN_DIR)
    message(FATAL_ERROR "BUILD_DIR, APP_DIR and BIN_DIR are required")
endif()
file(SHA256 "${BUILD_DIR}/bin/sos-ftxui" tui_hash)
file(SHA256 "${BUILD_DIR}/bin/sosd" daemon_hash)
string(SHA256 version "${tui_hash}${daemon_hash}")
set(destination "${APP_DIR}/${version}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --component ftxui --prefix "${destination}"
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Native TUI installation failed")
endif()
file(MAKE_DIRECTORY "${BIN_DIR}")
file(CREATE_LINK "${destination}/bin/sos-ftxui" "${BIN_DIR}/sos-ftxui.new" SYMBOLIC RESULT result)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Cannot create sos-ftxui launcher: ${result}")
endif()
file(RENAME "${BIN_DIR}/sos-ftxui.new" "${BIN_DIR}/sos-ftxui")
message(STATUS "Installed ${BIN_DIR}/sos-ftxui")
