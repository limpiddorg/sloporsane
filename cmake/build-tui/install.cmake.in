# Keep installed versions immutable: a shared daemon may still use an older one.
file(MAKE_DIRECTORY "@SOS_TUI_INSTALL_DIR@")
file(LOCK "@SOS_TUI_INSTALL_DIR@/.install.lock" GUARD PROCESS TIMEOUT 30)
file(SHA256 "@TUI_ARCHIVE@" DISTRIBUTION_HASH)
set(destination "@SOS_TUI_INSTALL_DIR@/${DISTRIBUTION_HASH}")
if(NOT EXISTS "${destination}/.complete")
    file(MAKE_DIRECTORY "${destination}")
    file(COPY "@TUI_DIST_DIR@/sos" DESTINATION "${destination}")
    file(WRITE "${destination}/.complete" "")
endif()
file(MAKE_DIRECTORY "@SOS_TUI_BIN_DIR@")
file(CREATE_LINK "${destination}/sos/sos" "@SOS_TUI_BIN_DIR@/sos" SYMBOLIC RESULT result)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Could not install sos launcher: ${result}")
endif()
message(STATUS "Installed sos: @SOS_TUI_BIN_DIR@/sos")
message(STATUS "Shareable archive: @TUI_ARCHIVE@")
