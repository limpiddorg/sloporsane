# Keep third-party options local to this dependency.
function(sos_add_websocket)
    include(FetchContent)
    if(POLICY CMP0135)
        cmake_policy(SET CMP0135 NEW)
    endif()
    set(USE_TLS ON)
    set(USE_OPEN_SSL ON)
    set(USE_SECURE_TRANSPORT OFF)
    set(USE_ZLIB OFF)
    set(USE_TEST OFF)
    set(USE_WS OFF)
    set(BUILD_DEMO OFF)
    set(BUILD_SHARED_LIBS OFF)
    set(IXWEBSOCKET_INSTALL OFF)
    FetchContent_Declare(ixwebsocket
        URL https://github.com/machinezone/IXWebSocket/archive/refs/tags/v11.4.6.tar.gz)
    FetchContent_MakeAvailable(ixwebsocket)
endfunction()
sos_add_websocket()
