#!/bin/bash
# The backend replaces only these Base64 placeholders. Never evaluate shell input.
set -euo pipefail
version_base64='@@VERSION_BASE64@@'
release_url_base64='@@RELEASE_URL_BASE64@@'

fail() { printf 'Error: %s\n' "$*" >&2; exit 1; }
case "$(uname -s):$(uname -m)" in
    Darwin:arm64) platform=macos-arm64; decode_flag=-D ;;
    Linux:x86_64) platform=linux-x86_64; decode_flag=-d ;;
    *) fail "Supported platforms: macOS ARM64 and Linux x86_64." ;;
esac
for value in "$version_base64" "$release_url_base64"; do
    [[ "$value" =~ ^[A-Za-z0-9+/]+={0,2}$ ]] || fail "Installer configuration was not rendered correctly."
done
version=$(printf '%s' "$version_base64" | base64 "$decode_flag") || fail "Invalid version encoding."
release_url=$(printf '%s' "$release_url_base64" | base64 "$decode_flag") || fail "Invalid download URL encoding."
[[ "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9.-]+)?$ ]] || fail "Invalid release version."
[[ "$release_url" == https://* && "$release_url" != *[$'\r\n\t ']* ]] || fail "Download URL must use HTTPS without whitespace."
release_url=${release_url%/}
[[ "${HOME:-}" == /* ]] || fail "HOME must be an absolute directory."
command -v curl >/dev/null || fail "curl is required."
command -v tar >/dev/null || fail "tar is required."
if command -v shasum >/dev/null; then
    hash_file() { shasum -a 256 "$1"; }
elif command -v sha256sum >/dev/null; then
    hash_file() { sha256sum "$1"; }
else
    fail "shasum or sha256sum is required."
fi
case "${XDG_DATA_HOME:-}" in
    /*) data_home=$XDG_DATA_HOME ;;
    *) data_home="$HOME/.local/share" ;;
esac
install_dir="$data_home/sos/app"
bin_dir="$HOME/.local/bin"
mkdir -p "$install_dir" "$bin_dir"
lock="$install_dir/.install.lock"
mkdir "$lock" 2>/dev/null || fail "Another installation is running (lock: $lock)."
work=
link=
cleanup() {
    if [[ -n "$link" ]]; then rm -f "$link"; fi
    if [[ -n "$work" ]]; then rm -rf "$work"; fi
    rmdir "$lock"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
work=$(mktemp -d "$install_dir/.download.XXXXXX")
asset="sos-$platform.tar.gz"
printf 'Installing SOS %s for %s\n' "$version" "$platform"
fetch() { curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --retry 3 --connect-timeout 15 --max-time 600 "$1" --output "$2"; }
fetch "$release_url/SHA256SUMS" "$work/SHA256SUMS"
fetch "$release_url/$asset" "$work/$asset"
expected=$(awk -v file="$asset" '$2 == file {print $1}' "$work/SHA256SUMS")
[[ "$expected" =~ ^[a-fA-F0-9]{64}$ ]] || fail "Missing or ambiguous archive checksum."
actual=$(hash_file "$work/$asset")
actual=${actual%% *}
expected=$(printf '%s' "$expected" | tr 'A-F' 'a-f')
[[ "$actual" == "$expected" ]] || fail "Archive checksum mismatch."
destination="$install_dir/$actual"
if [[ ! -f "$destination/.complete" ]]; then
    [[ ! -e "$destination" ]] || fail "Incomplete destination exists: $destination"
    # Release archives are trusted after checksum verification; reject unexpected roots.
    tar -tzf "$work/$asset" > "$work/entries"
    while IFS= read -r entry; do
        case "$entry" in sos|sos/|sos/*) ;; *) fail "Unexpected archive path." ;; esac
        case "/$entry/" in */../*) fail "Unsafe archive path." ;; esac
    done < "$work/entries"
    mkdir "$work/unpacked"
    tar -xzf "$work/$asset" -C "$work/unpacked"
    [[ -x "$work/unpacked/sos/sos" ]] || fail "Archive launcher is missing or not executable."
    printf '%s\n' "$version" > "$work/unpacked/.complete"
    mv "$work/unpacked" "$destination"
fi
[[ -x "$destination/sos/sos" ]] || fail "Installed launcher is missing."
[[ ! -d "$bin_dir/sos" || -L "$bin_dir/sos" ]] || fail "Cannot replace a directory: $bin_dir/sos"
link=$(mktemp "$bin_dir/.sos.XXXXXX")
rm "$link"
ln -s "$destination/sos/sos" "$link"
mv -f "$link" "$bin_dir/sos"
link=
printf 'Installed: %s/sos\n' "$bin_dir"
case ":$PATH:" in
    *:"$bin_dir":*) printf 'Run: sos\n' ;;
    *) printf 'Add %s to PATH, or run: "%s/sos"\n' "$bin_dir" "$bin_dir" ;;
esac
